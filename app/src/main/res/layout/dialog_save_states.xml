<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bergen_sans"
            android:text="Save States"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:fontFamily="@font/bergen_sans"
            android:text="Configure persistent player behaviour across sessions."
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bergen_sans"
                    android:text="Remember Aspect Ratio"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.6"
                    android:fontFamily="@font/bergen_sans"
                    android:text="Restore your last used aspect ratio on next play"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1dp" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_remember_aspect_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:focusable="true"
                app:thumbTint="@android:color/white"
                app:trackTint="@color/accent" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.07" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bergen_sans"
                    android:text="Force Lowest Quality"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.6"
                    android:fontFamily="@font/bergen_sans"
                    android:text="Always start streams at the lowest available quality"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1dp" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_force_lowest_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:focusable="true"
                app:thumbTint="@android:color/white"
                app:trackTint="@color/accent" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1" />

        <!-- Center Controls Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/bergen_sans"
            android:text="Center Controls Mode"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.6"
            android:fontFamily="@font/bergen_sans"
            android:text="Choose what appears in the center of the player controls. Only one option can be active."
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp" />

        <RadioGroup
            android:id="@+id/rg_center_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_seeks_only"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/bergen_sans"
                android:text="Seeks only"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:paddingStart="8dp" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_seeks_and_nav"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/bergen_sans"
                android:text="Seeks + Prev/Next channel"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:paddingStart="8dp" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_nav_only"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/bergen_sans"
                android:text="Prev/Next channel only"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:paddingStart="8dp" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_states_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:fontFamily="@font/bergen_sans"
                android:text="Cancel"
                android:textColor="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOnSurface"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_states_apply"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:focusable="true"
                android:fontFamily="@font/bergen_sans"
                android:text="Apply"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/accent" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
