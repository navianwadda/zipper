<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_appearance"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorPrimary"
            app:title="Appearance"
            app:titleTextColor="?attr/colorPrimary"
            app:titleTextAppearance="@style/AppearanceToolbarTitle"/>

    </com.google.android.material.appbar.AppBarLayout>

    
    <androidx.core.widget.NestedScrollView
        android:id="@+id/appearance_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme"
                android:textSize="13sp"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="@font/bergen_sans"
                android:letterSpacing="0.04"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="2dp"/>

            
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#22FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dark Mode"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.6"
                            android:fontFamily="@font/bergen_sans"
                            android:layout_marginBottom="10dp"/>

                        
                        <LinearLayout
                            android:id="@+id/dark_mode_selector"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:orientation="horizontal"
                            android:background="@drawable/segmented_button_bg"
                            android:padding="4dp">

                            <LinearLayout
                                android:id="@+id/btn_dark"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:background="@drawable/segmented_item_bg"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:id="@+id/icon_dark"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_theme_dark"
                                    android:layout_marginEnd="6dp"/>
                                <TextView
                                    android:id="@+id/text_dark"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/bergen_sans"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btn_light"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/segmented_item_bg"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:id="@+id/icon_light"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_theme_light"
                                    android:layout_marginEnd="6dp"/>
                                <TextView
                                    android:id="@+id/text_light"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Light"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/bergen_sans"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btn_system"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/segmented_item_bg"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:id="@+id/icon_system"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_theme_auto"
                                    android:layout_marginEnd="6dp"/>
                                <TextView
                                    android:id="@+id/text_system"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="System"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/bergen_sans"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1AFFFFFF"/>

                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App Theme"
                        android:textSize="13sp"
                        android:textColor="?attr/colorPrimary"
                        android:fontFamily="@font/bergen_sans"
                        android:layout_marginTop="14dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="10dp"/>

                    
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_themes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="14dp"
                        android:clipToPadding="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1AFFFFFF"/>

                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AMOLED Black Mode"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface"
                                android:fontFamily="@font/bergen_sans"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Use pure black background for dark themes"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.55"
                                android:layout_marginTop="2dp"/>

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_amoled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
