<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true">

    
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_preview"
        android:layout_width="72dp"
        android:layout_height="112dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeWidth="2dp"
        app:strokeColor="@android:color/transparent">

        <LinearLayout
            android:id="@+id/preview_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            
            <View
                android:id="@+id/preview_bar_top"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="@drawable/preview_bar_shape"
                android:layout_marginBottom="7dp"
                android:alpha="0.5"/>

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="7dp">

                
                <View
                    android:id="@+id/preview_switch"
                    android:layout_width="32dp"
                    android:layout_height="16dp"
                    android:background="@drawable/preview_switch_shape"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                
                <View
                    android:id="@+id/preview_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/preview_dot_shape"/>

            </LinearLayout>

            
            <View
                android:id="@+id/preview_bar_bottom"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="@drawable/preview_bar_shape"
                android:alpha="0.3"/>

            
            <View
                android:id="@+id/preview_dot_tertiary"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/preview_dot_shape"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    
    <TextView
        android:id="@+id/text_theme_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/bergen_sans"
        android:textColor="?attr/colorOnSurface"/>

</LinearLayout>
