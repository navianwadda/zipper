<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LiveTVPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorError">@color/error_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="Theme.LiveTVPro.Fullscreen" parent="Theme.LiveTVPro">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="AppTheme" parent="Theme.LiveTVPro" />

    <style name="ThemeOverlay.LiveTVPro.Dialog.Transparent" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorPrimary">@color/primary</item>
    </style>

    <style name="ThemeOverlay.NetworkStream.AmberHandles" parent="">
        <item name="colorControlActivated">@color/accent_amber</item>
        <item name="colorAccent">@color/accent_amber</item>
        <item name="colorPrimary">@color/accent_amber</item>
    </style>

    <style name="NetworkStreamEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textCursorDrawable">@drawable/cursor_amber</item>
    </style>

    <style name="TelegramBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/telegram_nav_item_color</item>
        <item name="itemTextColor">@color/telegram_nav_item_color</item>
    </style>

    <style name="TelegramBottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:background">@drawable/telegram_nav_indicator</item>
    </style>

    <style name="TelegramBottomNav.TextAppearance" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BottomNav.TextAppearance" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Sidebar.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemTextColor">@color/text_primary</item>
        <item name="itemIconTint">@color/text_primary</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.MaterialComponents.Tab">
        <item name="android:textSize">13sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="LinkSelectionDialogTheme" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:colorBackground">#2A2A2A</item>
        <item name="colorSurface">#2A2A2A</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E0E0E0</item>
        <item name="colorPrimary">#EF4444</item>
        <item name="colorAccent">#EF4444</item>
    </style>

    <style name="Widget.Material3.TextInputLayout.OutlinedExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" />

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="NavigationBarActiveIndicator" parent="">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

</resources>
